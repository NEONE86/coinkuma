    "sqlite_and_content_addressed_raw": true,
    "money_and_supply_use_decimal_or_integer_strings": true,
    "raw_and_runtime_outside_git": true,
    "all_rejected_and_unresolved_preserved": true,
    "hash_integrity_not_truth": true,
    "model_rerun_not_guaranteed_byte_identical": true
  },
  "accounting_invariants": [
    "fees != protocol retained revenue != holder accrual",
    "buyback != burn",
    "unlock != issuance",
    "treasury inventory burn != market purchase",
    "same buyback-to-burn flow counted once economically",
    "bridge representations not counted as new global supply",
    "author target != executed amount",
    "missing != zero",
    "market volume != net capital inflow"
  ],
  "price_math": {
    "unit": "single token buy-and-terminal-sell scenario, not a full portfolio backtest",
    "scenario_return": "(V_j*(1-c_sell)+D_j)/(P0*(1+c_buy))-1",
    "expected_return": "sum(p_j*scenario_return_j)",
    "break_even_entry": "sum(p_j*(V_j*(1-c_sell)+D_j))/(1+c_buy)",
    "entry_for_required_return": "sum(p_j*(V_j*(1-c_sell)+D_j))/((1+c_buy)*(1+r_required))",
    "cash_distribution_assumption": "simplified cash amount; early distributions and additional reward token units require separate accounting",
    "stale_or_missing_price": "no simulated current fill; conditional valuation only"
  },
