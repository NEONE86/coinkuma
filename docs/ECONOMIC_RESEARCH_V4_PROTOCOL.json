  "scoring_rules": {
    "report_counts": [
      "registered_forecasts",
      "due_forecasts",
      "resolved_forecasts",
      "unresolved_forecasts",
      "independent_event_clusters"
    ],
    "score_denominator": "resolved forecasts only, within the same question type, horizon and revision scoring policy",
    "coverage_denominator": "all registered or all due, explicitly labeled",
    "unresolved_not_zero_or_false": true,
    "unresolved_not_zero_loss_in_score_denominator": true,
    "resolved_subset_selection_bias_reported": true
  },
  "paper_action_rules": {
    "initial_llm_action_status": "PROPOSED",
    "proposal_creates_fill_or_pnl": false,
    "held_actions_require_actual_paper_portfolio_snapshot": true,
    "paper_applied_trade_requires_fills_and_reconciliation": true,
    "paper_hold_may_have_no_fill": true,
    "no_invented_real_account_holdings": true
  },
  "capture_adapter_requirements": {
    "legacy_evidence_store_reused_with_version_adapter": true,
    "additional_official_hosts_to_review": [
      "aave.com",
      "docs.pancakeswap.finance"
    ],
    "every_redirect_checked_before_request": true,
    "refresh_current_sources": true,
    "old_versions_retained": true,
    "price_asset_matches_decision": true
  }
