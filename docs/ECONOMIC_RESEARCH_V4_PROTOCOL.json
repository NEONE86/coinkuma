  "tests": [
    {
      "id": "T01",
      "assertion": "mutable URL revisions preserve original evidence and prior decisions"
    },
    {
      "id": "T02",
      "assertion": "late announcement with earlier effective date cannot enter an earlier forecast"
    },
    {
      "id": "T03",
      "assertion": "future-prefix invariance of earlier packet and decision references"
    },
    {
      "id": "T04",
      "assertion": "idempotent capture, event creation, forecast registration and economic flows"
    },
    {
      "id": "T05",
      "assertion": "no buyback/burn, unlock/issue or bridged-supply double counting"
    },
    {
      "id": "T06",
      "assertion": "symbol collisions and migrations require asset identity evidence"
    },
    {
      "id": "T07",
      "assertion": "missing/unresolved not zero/false; retained in coverage counts, excluded from proper-score denominator"
    },
    {
      "id": "T08",
      "assertion": "forecast and resolution amendments preserve original versions"
    },
    {
      "id": "T09",
      "assertion": "probability, horizon, joint/conditional scenarios, currency units and costs valid"
    },
    {
      "id": "T10",
      "assertion": "higher current price with otherwise fixed payoff lowers entry expected return"
    },
    {
      "id": "T11",
      "assertion": "immature 180-day outcomes do not block prospective registration or create training labels"
    },
    {
      "id": "T12",
      "assertion": "frozen policies share vintage inputs with separate records; no risk-authority modification; proposed actions create no fills"
    },
    {
      "id": "T13",
      "assertion": "raw/manifest corruption and receipt recovery after interrupted write are detected"
    },
    {
      "id": "T14",
      "assertion": "evidence links/source controls validated and document instructions are untrusted"
    }
  ],
  "initial_deliverables": [
    "working one-cycle path from source receipt to forecast and report",
    "target three current judgment cards without forced positive events or trades",
    "selection and rejection reasons with change conditions",
    "pending outcomes correctly labeled",
    "resolution and policy revision pathway exercised with explicitly synthetic fixtures",
    "reproduction commands and code change summary",
    "actual source failures and unimplemented operational pieces"
  ],
  "no_initial_build": [
    "all-market perfect historical reconstruction",
    "LLM finetuning",
    "complex reinforcement learning",
    "large vector database",
    "arbitrary weighted alpha score",
    "forced monthly-target trading",
    "unattended deployment",
    "real orders or leverage"
  ],
