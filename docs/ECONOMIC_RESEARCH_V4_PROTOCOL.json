  "probability_rules": [
    "subjective forecasts permitted with labeled basis and evidence",
    "unknown base rates remain null",
    "no model-token likelihood as event probability",
    "same target horizon across payoff scenarios",
    "sum joint scenario probabilities equals one",
    "do not multiply correlated marginal forecasts as independent",
    "conditional branches must identify parent and sum to one under parent"
  ],
  "temporal_invariants": [
    "prospective inputs available_at <= registered_at",
    "observed_at is actual receipt, never backdated to effective_at",
    "registered_at precedes unresolved prospective deadline",
    "future data cannot rewrite earlier as-of packets",
    "maturity gates evaluation and learning, not current event collection or paper entry",
    "forecast revisions preserve initial prediction",
    "LLM historical knowledge contamination is separately disclosed",
    "input.available_at <= packet.as_of == forecast.knowledge_cutoff <= registered_at",
    "registered_at is assigned by the actual storage operation, not trusted from imported analysis",
    "updated decision prices must have available_at <= new decision_at"
  ],
